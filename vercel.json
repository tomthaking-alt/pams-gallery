{
  "redirects": [
    { "source": "/((?!ar/).+)", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/ar/(.*)\\.usdz", "headers": [ { "key": "Content-Type", "value": "model/vnd.usdz+zip" }, { "key": "Cache-Control", "value": "public, max-age=3600" } ] },
    { "source": "/ar/(.*)\\.glb", "headers": [ { "key": "Content-Type", "value": "model/gltf-binary" }, { "key": "Access-Control-Allow-Origin", "value": "*" }, { "key": "Cache-Control", "value": "public, max-age=3600" } ] }
  ]
}
